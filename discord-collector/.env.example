# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=discord_collector

# ---------- Discord 网页（CDP 附加模式推荐）----------
# 本机 Chrome 带远程调试：/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
CDP_CONNECT_URL=http://127.0.0.1:9222
# 若配置了 HTTP(S)_PROXY，务必排除本机，否则 Playwright 连 CDP 会 400
# NO_PROXY=127.0.0.1,localhost,::1
# CDP 附加后自动打开的频道（保活）；也用于无头模式 goto
TARGET_PAGE_URL=https://discord.com/channels/GUILD_ID/CHANNEL_ID
COLLECTOR_START_URL=https://discord.com/channels/GUILD_ID/CHANNEL_ID
# COLLECTOR_CDP_AUTO_GOTO=1
# COLLECTOR_PAGE_RELOAD_INTERVAL_MS=300000
# 伪造 Discord 标签页始终前台（减轻后台 Gateway 节流）；0=关闭
# COLLECTOR_CDP_VISIBILITY_KEEPALIVE=1
# 定时 CDP 轮询信号频道（每次只切 1 个）；默认开，间隔 10 分钟
# COLLECTOR_CDP_CHANNEL_ROTATE=1
# COLLECTOR_CDP_CHANNEL_ROTATE_INTERVAL_MS=600000
# 关闭轮询：COLLECTOR_CDP_CHANNEL_ROTATE=0
# 同一频道 CDP 导航防抖（毫秒，部署多人访问建议保留）
# COLLECTOR_CDP_NAV_DEBOUNCE_MS=10000

# ---------- 采集 UI ----------
COLLECTOR_UI_PORT=3851
LOG_LEVEL=info

# ---------- Umami 访客统计 ----------
# 已写入 collector-ui-vue/index.html（website-id=2a409684-5ffa-4c8c-8b28-68c2b22c21ee）
# 脚本：https://bz.ezcoin.ink/script.js — 改 ID 后重新 ui:build

# ---------- 前端界面模式（构建时注入）----------
# local = 全部页面；deploy = 仅 VITE_UI_PAGES（默认 show,fetch,oi）
# 也可依赖 .env.development / .env.production（已内置默认）
# VITE_UI_MODE=deploy
# VITE_UI_PAGES=show,fetch,oi
# 部署版若还要开卡片/Debug：VITE_UI_PAGES=show,fetch,oi,cards,debug

# COLLECTOR_NETWORK_TRACE=1
# COLLECTOR_WS_FRAME_TRACE=1
# Gateway 实时消息行 [gateway MESSAGE_CREATE] …（默认 0 不打印群聊）
# DISCORD_GATEWAY_MESSAGE_LOG=1

# JSON 入库校验顶层键；Discord Gateway 留空表示任意 object 均可
COLLECTOR_REQUIRED_KEYS=

# 仅处理这些 guild id 的消息（逗号分隔，空=全部）
# DISCORD_MONITORED_GUILD_IDS=1234567890,9876543210

# Debug 模式（默认开）：1=全量 WS/API 日志与 UI 原始 JSON；0=精简一行摘要
DISCORD_DEBUG_MODE=1

# ---------- 信号卡片 / Telegram / Ollama ----------
# 信号卡片监听频道（10 个）：大镖客,淑琴,飞扬,三马,seven,峰哥,颜驰,币安杀手,unknown-trader,山寨之王
# 信号卡片监听频道：大镖客,淑琴,飞扬,三马,seven,峰哥,颜驰,山寨之王,币圈所长（币安杀手/unknown-trader 可另加）
DISCORD_SIGNAL_CHANNEL_IDS=1444962339743989843,1444962376066793513,1444962410002911396,1444962439471955989,1444963372134301827,1444963929393729686,1444963689194192947,1444963506431463474,1444963405185159238,1444963474718462085
# Telegram 原始消息推送（非信号卡片频道；信号频道走卡片 Telegram，见上）
DISCORD_TELEGRAM_PUSH_CHANNEL_IDS=1444963689194192947,1444962439471955989,1444962376066793513,1444962339743989843,1444963372134301827,1459861535815110810,1444967547169669160,1444967575858581545,1444963506431463474
# Telegram 实时推送频道（不参与 2 分钟聚合，收到即发；留空则全部走聚合）
# DISCORD_TELEGRAM_REALTIME_CHANNEL_IDS=
# DISCORD_TELEGRAM_PUSH_DEBOUNCE_MS=120000
# Gateway 先转发 Telegram/Webhook 再入库（默认 1；设 0 恢复「入库成功后再转发」）
# DISCORD_TELEGRAM_PRIORITY_FORWARD=1
# TELEGRAM_SEND_URL=http://127.0.0.1:8000/api/telegram/send
# TELEGRAM_PUSH_CHAT_ID=-100123456789

# ---------- 卡片外送（oi_mornitor，建卡时推送；同仓见 oi_mornitor/）----------
# 先 pnpm run oi:dev / oi:start，再 collect:ui；顶栏切换到「OI Monitor」运行时激活嵌入
# CARD_SINK_ENABLED=1
# CARD_SINK_WS_URL=ws://127.0.0.1:8765/ws/cards
# CARD_SINK_HTTP_URL=http://127.0.0.1:8765/api/cards
# CARD_SINK_TIMEOUT_MS=8000
# CARD_SINK_RECONNECT_MS=3000
# OI_WEB_BASE_URL=http://127.0.0.1:8765
# 沙盒纸面持仓超过 N 天市价强平（默认 2）
# OI_SANDBOX_MAX_HOLD_DAYS=2
# OI_EMBED_URL=http://127.0.0.1:5173
# 前端上云时浏览器 iframe 用（frp 映射 oi:8765 后的公网地址）
# OI_PUBLIC_EMBED_URL=http://149.88.80.60:39134
# OI_HEALTH_TIMEOUT_MS=3000
# 部署版默认：VITE_UI_PAGES=show,fetch,oi

# ---------- 网络代理（Node 侧 API / Webhook，需与 Chrome 一致） ----------
# 统一代理：Bitget / WEEX / Webhook / 币安等默认共用；各模块可用 *_PROXY 单独覆盖
# COMMON_PROXY=http://127.0.0.1:7890

# ---------- Discord Webhook 频道转发 ----------
# 映射文件（默认 config/channel-webhook-forwards.json，含 webhook token，勿提交 git）
# 复制 config/channel-webhook-forwards.example.json 后填写 guildId / channelId / webhookUrl
# DISCORD_WEBHOOK_FORWARDS_FILE=
# DISCORD_WEBHOOK_FORWARD_TIMEOUT_MS=15000
# Node 发 Webhook 用的代理（需与 Chrome 一致，否则 fetch failed / 连接超时）
# DISCORD_WEBHOOK_PROXY=http://127.0.0.1:7890
# Webhook 转发逐条日志 POST / 已转发（默认 0 不打印，避免刷屏）
# DISCORD_WEBHOOK_FORWARD_LOG=1
# 卡片价格校验 / 回测 / 接近检查逐条日志（默认 0 不打印）
# DISCORD_CARDPULL_FORWARD_LOG=1

# ---------- 统一卡片归档 / 开放 API ----------
# 对外开放 /api/v1/cards（Header: X-Cards-Api-Key 或 Authorization: Bearer）
# CARDS_API_KEY=your-secret-key
# BINANCE_FAPI_URL=https://fapi.binance.com
# BINANCE_PROXY=http://127.0.0.1:7890
# CARD_PRICE_MONITOR_INTERVAL_MS=60000
# 接近推送 — 加密：每 1h，距关键位 ≤1%
# CARD_PROXIMITY_CRYPTO_CHECK_MS=3600000
# CARD_PROXIMITY_CRYPTO_BAND_PCT=1.0
# 接近推送 — 股票：每 1 天，剩余落差 ≤10%（100→110 在 109–110 提醒）
# CARD_PROXIMITY_STOCK_CHECK_MS=86400000
# CARD_PROXIMITY_STOCK_GAP_PCT=0.1
# CARD_VERIFY_CRYPTO_WINDOW_DAYS=1
# CARD_VERIFY_DEFAULT_HOURS=3
# CARD_VERIFY_STOCK_WINDOW_DAYS=30
# CARD_VERIFY_LEVERAGE=100
# 评价盈利计算默认杠杆：主流 BTC/ETH、山寨
# CARD_EVAL_MAJOR_LEVERAGE=100
# CARD_EVAL_ALTCOIN_LEVERAGE=20
# 新卡片 Toast 位置：bottom-right（默认）| top-right
# CARD_TOAST_POSITION=bottom-right
# 浏览器桌面通知（需授权，默认关）
# CARD_TOAST_DESKTOP=1
# CARD_PROXIMITY_COOLDOWN_MS=300000
# CARD_PROXIMITY_TELEGRAM=0

# ---------- 文稿解析（WhisprRT output 等目录 *.txt）----------
# PASTE_PARSE_INPUT_DIR=/Users/maotouying/frontend/code/1.operations/WhisprRT/output
# PASTE_PARSE_OUTPUT_DIR=discord-collector/data/paste-parse
# PASTE_PARSE_STARTUP_DELAY_MS=15000
# PASTE_PARSE_WATCH_INTERVAL_MS=600000

# ---------- Bitget 合约自动下单 ----------
# 密钥仅放 .env，勿提交 git；频道策略见 config/bitget-trade-channels.json
# BITGET_ENABLED=1
# BITGET_DRY_RUN=1
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_PASSPHRASE=
# BITGET_BASE_URL=https://api.bitget.com
# BITGET_PROXY=http://127.0.0.1:7890
# BITGET_REQUEST_TIMEOUT_MS=15000
# 非空时仅这些 Discord 频道触发（逗号分隔）；留空则读 JSON channels
# 主流币 BTC/ETH 不自动交易，仅山寨币会下单
# BITGET_AUTO_TRADE_CHANNEL_IDS=1444963405185159238
# BITGET_DEFAULT_LEVERAGE=30
# 每笔保证金 (USDT)，与 Bitget App「金额」一致；仓位名义 = 保证金 × 杠杆
# BITGET_ORDER_SIZE_USDT=1
# 杠杆配置保留：手动下单等仍可区分主流/山寨；自动交易已排除主流
# BITGET_MAJOR_LEVERAGE=100
# BITGET_ALTCOIN_LEVERAGE=30
# BITGET_INITIAL_SL_PCT=4.3
# BITGET_TRADE_CONFIG_FILE=

# ---------- WEEX 合约自动下单（交易参数默认与 Bitget 共用 BITGET_*）----------
# WEEX_ENABLED=1
# WEEX_DRY_RUN=0
# WEEX_API_KEY=
# WEEX_API_SECRET=
# WEEX_PASSPHRASE=
# WEEX_BASE_URL=https://api-contract.weex.com
# WEEX_PROXY=
# 留空则沿用 BITGET_AUTO_TRADE_CHANNEL_IDS
# WEEX_AUTO_TRADE_CHANNEL_IDS=

# ---------- 社区聊天室 ----------
# 媒体落盘目录（默认 discord-collector/uploads/chat）
# COMMUNITY_CHAT_UPLOAD_DIR=
# COMMUNITY_CHAT_IMAGE_MAX_BYTES=5242880
# COMMUNITY_CHAT_VIDEO_MAX_BYTES=20971520
