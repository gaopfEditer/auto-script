# 打包部署版（pnpm run ui:build）：Show + 拉取 + OI（其它路由不打进产物）
VITE_UI_MODE=deploy
VITE_UI_PAGES=show,fetch,oi
# 若要上内容板：VITE_UI_PAGES=show,fetch,oi,content
# 本机编辑拷贝时写成公网域名（可选；手机直接打开部署域名则不需要）
# VITE_CONTENT_PUBLIC_ORIGIN=https://your.domain.com
# 云上 iframe 嵌入 OI 的公网地址（须浏览器可访问；可走 frp 暴露的 oi :8765）
# 例：https://oi.example.com  或  http://149.88.80.60:39134
# VITE_OI_PUBLIC_EMBED_URL=http://149.88.80.60:39134
