  "embedSchema": {
    "type": "DiscordEmbed-like",
    "fields": [
      "title",
      "description?",
      "color",
      "fields[{name,value,inline}]",
      "footer",
      "timestamp"
    ],
    "color": {
      "long": "0x57f287",
      "short": "0xed4245",
      "neutral": "0x5865f2"
    },
