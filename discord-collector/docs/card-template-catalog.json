      "description": "淑琴/BTC 中文"
    },
    "streak_cn": {
      "fields": [
        "title|symbol",
        "入场(可多档)",
        "止盈(多档)",
        "止损"
      ],
      "description": "三马连胜"
    },
    "cn_market_family": {
      "parsers": [
        "dabiaoke",
        "feiyang",
        "fengge",
        "yanchi",
        "biquan_suozhang",
        "unknown_trader",
        "altcoin_king"
