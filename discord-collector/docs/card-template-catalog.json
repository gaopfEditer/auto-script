{
  "version": "1.2",
  "purpose": "供外部评估的信号卡片模板目录（风格文案 + 解析器回退排版 + Embed 结构化字段）",
  "cardUid": {
    "format": "SC-{dbId}",
    "description": "唯一标识仅在 uid / Embed「标识」/ 外送 JSON card_id；正文不出现 ID SC-xxx",
    "example": "SC-1004"
  },
  "styleTemplates": {
    "cn_formal": {
      "id": "cn_formal",
      "label": "简体·正式",
      "promptHint": "简体中文，正式完整，条理清晰",
      "usage": "AI 生成卡片正文时的语言/语气约束；fallback 时影响用词（简/繁/英）"
    },
    "cn_brief": {
      "id": "cn_brief",
      "label": "简体·极简",
      "promptHint": "简体中文，极简 Telegram 风格，≤80字",
      "usage": "AI 生成卡片正文时的语言/语气约束；fallback 时影响用词（简/繁/英）"
    },
    "tw_formal": {
      "id": "tw_formal",
      "label": "繁体·正式",
      "promptHint": "繁体中文，正式完整",
      "usage": "AI 生成卡片正文时的语言/语气约束；fallback 时影响用词（简/繁/英）"
    },
    "en_brief": {
      "id": "en_brief",
      "label": "English",
      "promptHint": "Concise English for traders, ≤100 chars",
      "usage": "AI 生成卡片正文时的语言/语气约束；fallback 时影响用词（简/繁/英）"
    }
  },
  "parserFallbackLayouts": {
    "binance_killers": {
      "fields": [
        "title·symbol",
        "方向",
        "入场",
        "杠杆",
        "目标(多档)",
        "止损",
        "signalId(原文信号ID，非 SC)"
