# news_mornitor — 金十宏观 + 币安/OKX 热榜
NEWS_HOST=127.0.0.1
NEWS_PORT=8770
# 兼容旧名
# CRYPTO_PULSE_HOST=127.0.0.1
# CRYPTO_PULSE_PORT=8770

NEWS_MACRO_MIN_STAR=3
NEWS_MACRO_AHEAD_HOURS=72
NEWS_MACRO_BEHIND_HOURS=72
# 宏观时间轴 8h；热榜/其它源 1h（可单独覆盖）
NEWS_MACRO_REFRESH_SEC=28800
NEWS_HOT_REFRESH_SEC=3600
# 兼容旧名：仅在未设 NEWS_HOT_REFRESH_SEC 时作为热榜间隔
# NEWS_REFRESH_SEC=3600

# Chrome CDP（HTTP 失败时页内 fetch / DOM）
# 启动示例：
# /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#   --remote-debugging-port=9222 --remote-allow-origins=*
NEWS_CDP=1
# 0=仅本机可 POST 刷新 / ?refresh=1；生产端只读缓存（默认）
# NEWS_REFRESH_ALLOW_REMOTE=0
# NEWS_COINDESK_URL=https://www.coindesk.com/zh/latest-crypto-news
# NEWS_BLOCKBEATS_URL=https://www.theblockbeats.info/newsflash
CHROME_DEBUG_PORT=9222

# HTTPS_PROXY=http://127.0.0.1:7890
# NEWS_PANEWS_API=https://universal-api.panewslab.com
# NEWS_PANEWS_CALENDAR_URL=https://www.panewslab.com/zh/calendar
