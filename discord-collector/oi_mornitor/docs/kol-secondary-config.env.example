# KOL 二次预警 — 复制到 ~/.grokbot/kol-secondary/config.env
# 勿提交真实 KEY / 密码

KOL_SECONDARY_ALERT_ENABLED=1
KOL_DRY_RUN=0

# Grok 主 webhook
KOL_GROK_WEBHOOK_URL=
KOL_GROK_WEBHOOK_KEY=

# Grok 备 webhook（双 Bot 同 payload）
KOL_GROK_WEBHOOK_URL_2=
KOL_GROK_WEBHOOK_KEY_2=

KOL_POLL_SEC=45
KOL_ALERT_TF=15m
KOL_FOLLOW_PATTERNS=inverted_hammer,engulfing,shooting_star
KOL_LEADER_SYMBOLS=BTC,ETH,QQQ
KOL_FOLLOW_ALL_RECENT=0

# 信号有效期：TTL 内未入场 → ignored_expired（默认 4h，下限 4h）
KOL_SIGNAL_TTL_HOURS=4
# 入场价：信号柱下一根 15m 开盘价 + 滑点（对齐回测 next_bar_open）
KOL_ENTRY_SLIPPAGE_PCT=0.03

KOL_VOL_LOOKBACK=20
KOL_VOL_MULT=2.0
KOL_EMA_PERIOD=144
KOL_EMA_NEAR_PCT=1.5
KOL_ALERT_INCLUDE_FORMING=0

# MySQL（discord_signal_cards）
KOL_MYSQL_HOST=127.0.0.1
KOL_MYSQL_PORT=3306
KOL_MYSQL_USER=root
KOL_MYSQL_PASSWORD=
KOL_MYSQL_DB=discord_collector
