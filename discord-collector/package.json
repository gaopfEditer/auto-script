{
  "name": "discord-collector",
  "version": "1.0.0",
  "private": true,
  "description": "CDP monitor for Discord web — capture Gateway WebSocket + REST API traffic",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "collect": "node src/index.js --mode=collect",
    "collect:live": "COLLECTOR_UI_EMBED=1 node src/index.js --mode=collect",
    "collect:ui": "node scripts/pre-collect-ui.mjs && node src/collector-ui-server.js",
    "ui:build": "vite build --config collector-ui-vue/vite.config.js",
    "dev:ui-vue": "node scripts/pre-dev-ui-vue.mjs && vite --config collector-ui-vue/vite.config.js",
    "dev:collect": "nodemon src/index.js",
    "dev:collect:ui": "node scripts/pre-collect-ui.mjs && nodemon src/collector-ui-server.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "nodemon": "^3.1.9",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "playwright": "^1.49.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "ws": "^8.18.0"
  }
}
