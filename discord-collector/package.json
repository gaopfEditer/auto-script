{
  "name": "discord-collector",
  "version": "1.0.0",
  "private": true,
  "description": "CDP monitor for Discord web — capture Gateway WebSocket + REST API traffic",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "collect": "node src/index.js --mode=collect",
    "collect:live": "COLLECTOR_UI_EMBED=1 node src/index.js --mode=collect",
    "collect:ui": "node scripts/pre-collect-ui.mjs",
    "build:all": "pnpm run oi:ui:build && node scripts/sync-oi-dist-public.mjs && vite build --config collector-ui-vue/vite.config.js && node scripts/sync-news-embed-public.mjs && node scripts/print-build-artifacts.mjs",
    "ui:build": "pnpm run build:all",
    "build:oi": "pnpm run oi:ui:build",
    "oi:ui:build": "pnpm --dir oi_mornitor/frontend run build && node scripts/verify-oi-dist.mjs && node scripts/sync-oi-dist-public.mjs",
    "dev:ui-vue": "node scripts/pre-dev-ui-vue.mjs && vite --config collector-ui-vue/vite.config.js",
    "build:ui-vue": "vite build --config collector-ui-vue/vite.config.js && node scripts/sync-news-embed-public.mjs",
    "dev:collect": "nodemon src/index.js",
    "dev:collect:ui": "node scripts/pre-collect-ui.mjs",
    "oi:start": "oi_mornitor/venv/bin/python oi_mornitor/run.py",
    "oi:dev": "oi_mornitor/venv/bin/python oi_mornitor/run.py --dev",
    "oi:rebuild": "oi_mornitor/venv/bin/python oi_mornitor/run.py --rebuild",
    "oi:publish-potential": "PYTHONPATH=. oi_mornitor/venv/bin/python oi_mornitor/scripts/publish_potential_json.py",
    "oi:potential-scan": "PYTHONPATH=. oi_mornitor/venv/bin/python oi_mornitor/scripts/run_potential_scan_once.py",
    "news:start": "PYTHONPATH=. ${NEWS_PYTHON:-../../auto-deal-eth/news_mornitor/venv/bin/python} news_mornitor/run.py web",
    "content:start": "PYTHONPATH=. oi_mornitor/venv/bin/python -m content_board",
    "test": "BITGET_SKIP_TELEGRAM_ALERT=1 node --test src/*.test.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "nodemon": "^3.1.9",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "2.2.0",
    "mysql2": "^3.12.0",
    "playwright": "^1.49.0",
    "undici": "^8.5.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "ws": "^8.18.0"
  }
}