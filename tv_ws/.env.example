# TradingView WebSocket 推送（复制到项目根 .env 或 tv_ws 同级 .env）

# WSS 地址
MAIN_WS_URL=wss://bz.a.gaopf.top/api/ws

# 默认只处理 1h / 4h；--only-telegram 时为 15m/1h/4h
WS_ALLOWED_PERIODS=1h,4h

# Telegram（润色/原文推送）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 设为 1 关闭 Telegram
# WS_SKIP_TELEGRAM=1

# 截图目录（需可写）
SCREENSHOT_DIR=/Volumes/RamDisk/app_screenshots

# Chrome 远程调试（截图 / 广场发布）
USE_REMOTE_DEBUGGING=True
CHROME_DEBUG_PORT=9222

# Ollama 润色（默认本地）
PROMAT_ANALYSIS_OLLAMA_ENABLED=true
PROMAT_ANALYSIS_OLLAMA_BASE_URL=http://localhost:11434
PROMAT_ANALYSIS_OLLAMA_MODEL=gemma-uncensored
PROMAT_ANALYSIS_OLLAMA_TIMEOUT_SEC=120

# WebSocket 保活（截图+润色可能较久）
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=300
WS_RECONNECT_SEC=5
WS_RECONNECT_MAX_SEC=120

# 币安广场（--public 时）
BINANCE_SQUARE_PUBLISH_URL=https://www.binance.com/zh-CN/square
