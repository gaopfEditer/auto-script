# ---------- CDP / Chrome ----------
CDP_CONNECT_URL=http://127.0.0.1:9222

# ---------- HTTP API ----------
YOUTUBE_FETCH_PORT=3920
YOUTUBE_TRANSCRIPT_SITE=https://youtube-transcript.ai
YOUTUBE_FETCH_TIMEOUT_MS=90000
YOUTUBE_FETCH_LOG_LEVEL=info

# ---------- 归档 ----------
# 相对仓库根目录，或绝对路径
YOUTUBE_ARCHIVES_DIR=youtube-fetch/archives

# ---------- deal-video WebSocket 触发 ----------
# 连接上游任务分发（type=deal-video）
DEAL_VIDEO_WS_ENABLED=1
DEAL_VIDEO_WS_URL=ws://127.0.0.1:3123/api/ws?type=deal-video
DEAL_VIDEO_WS_RECONNECT_MS=5000
DEAL_VIDEO_CLIENT_NAME=youtube-fetch
# 收到 deal_video_task 时是否默认走 Ollama 分析（也可用 task.meta.analyze）
DEAL_VIDEO_ANALYZE=0
# 处理完成后是否回传 deal_video_result
DEAL_VIDEO_WS_REPORT_RESULT=1

# ---------- Ollama 文稿分析（可选）----------
YOUTUBE_ANALYZE=0
OLLAMA_CHAT_URL=http://127.0.0.1:8000/ollama/chat
OLLAMA_MODEL=gemma4:26b
# 本地 Ollama 连不上时回退 DeepSeek（需配置 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com
YOUTUBE_ANALYZE_TIMEOUT_MS=120000
YOUTUBE_ANALYZE_MAX_CHARS=14000
# YOUTUBE_ANALYZE_PROMPT=...
# YOUTUBE_ANALYZE_PROMPT_FILE=prompts/youtube-analyze.txt
